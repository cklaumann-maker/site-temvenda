    <script>
        // ============================================
        // VERSÃO: instagram.html v4.0 - 2025-11-03
        // Design: Fundo preto + blocos claros + espaço para imagem
        // Suporte a HTML/parágrafos nos textos
        // ============================================

        // Função para renderizar HTML nos elementos
        function renderHTML(element, content) {
            if (!element || !content) return;
            
            // Se o conteúdo contém tags HTML, usar innerHTML, senão textContent
            if (content.includes('<') && content.includes('>')) {
                element.innerHTML = content;
            } else {
                element.textContent = content;
            }
        }

        // Carregar configurações da página via REST API
        async function loadPageConfig() {
            console.log('🔄 Carregando configurações do banco de dados...');
            
            const mainTitleEl = document.getElementById('main-title');
            const mainSubtitleEl = document.getElementById('main-subtitle');
            const benefitTitle1El = document.getElementById('benefit-title-1');
            const benefitText1El = document.getElementById('benefit-text-1');
            const benefitTitle2El = document.getElementById('benefit-title-2');
            const benefitText2El = document.getElementById('benefit-text-2');
            const benefitTitle3El = document.getElementById('benefit-title-3');
            const benefitText3El = document.getElementById('benefit-text-3');
            const benefitTitle4El = document.getElementById('benefit-title-4');
            const benefitText4El = document.getElementById('benefit-text-4');
            const submitBtnEl = document.getElementById('submitBtn');
            const heroImageEl = document.getElementById('hero-image');
            const heroImagePlaceholder = document.getElementById('hero-image-placeholder');
            
            if (!mainTitleEl || !mainSubtitleEl || !benefitTitle1El || !benefitText1El || !submitBtnEl) {
                console.warn('⚠️ Elementos DOM não encontrados, tentando novamente em 500ms...');
                setTimeout(loadPageConfig, 500);
                return;
            }
            
            try {
                const supabaseUrl = window.SUPABASE_CONFIG?.url || 'https://mgcoyeohqelystqmytah.supabase.co';
                const supabaseServiceKey = window.SUPABASE_CONFIG?.serviceKey;
                const supabaseAnonKey = window.SUPABASE_CONFIG?.anonKey || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1nY295ZW9ocWVseXN0cW15dGFoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjE2NzAzNjQsImV4cCI6MjA3NzI0NjM2NH0.KBKHH10DaV0m5SroFmXsTedS_dalcAprKnUOI4Unkx4';
                
                const supabaseKey = supabaseServiceKey || supabaseAnonKey;
                
                const response = await fetch(
                    `${supabaseUrl}/rest/v1/instagram_capture_config?select=*&order=updated_at.desc&limit=1`,
                    {
                        headers: {
                            'apikey': supabaseKey,
                            'Authorization': `Bearer ${supabaseKey}`,
                            'Content-Type': 'application/json'
                        }
                    }
                );
                
                if (response.ok) {
                    const dataArray = await response.json();
                    const config = (dataArray && dataArray.length > 0) ? dataArray[0] : {};
                    
                    console.log('✅ Configurações recebidas do banco:', config);
                    
                    // Renderizar HTML nos elementos (suporta HTML ou texto simples)
                    renderHTML(mainTitleEl, config.main_title || '');
                    renderHTML(mainSubtitleEl, config.main_subtitle || '');
                    renderHTML(benefitTitle1El, config.benefit1_title || '');
                    renderHTML(benefitText1El, config.benefit1_text || '');
                    renderHTML(benefitTitle2El, config.benefit2_title || '');
                    renderHTML(benefitText2El, config.benefit2_text || '');
                    renderHTML(benefitTitle3El, config.benefit3_title || '');
                    renderHTML(benefitText3El, config.benefit3_text || '');
                    renderHTML(benefitTitle4El, config.benefit4_title || '');
                    renderHTML(benefitText4El, config.benefit4_text || '');
                    if (submitBtnEl) submitBtnEl.textContent = config.button_text || '';
                    
                    // Carregar imagem do hero (se houver campo hero_image_url)
                    if (config.hero_image_url && config.hero_image_url.trim() !== '' && config.hero_image_url.startsWith('http')) {
                        heroImageEl.src = config.hero_image_url.trim();
                        heroImageEl.style.display = 'block';
                        heroImagePlaceholder.style.display = 'none';
                        console.log('✅ Imagem do hero carregada:', config.hero_image_url);
                    } else {
                        heroImageEl.style.display = 'none';
                        heroImagePlaceholder.style.display = 'flex';
                    }
                    
                    // Guardar no localStorage
                    localStorage.setItem('instagram_config', JSON.stringify({
                        mainTitle: config.main_title,
                        mainSubtitle: config.main_subtitle,
                        benefit1_title: config.benefit1_title,
                        benefit1_text: config.benefit1_text,
                        benefit2_title: config.benefit2_title,
                        benefit2_text: config.benefit2_text,
                        benefit3_title: config.benefit3_title,
                        benefit3_text: config.benefit3_text,
                        benefit4_title: config.benefit4_title,
                        benefit4_text: config.benefit4_text,
                        buttonText: config.button_text,
                        pdf_url: config.pdf_url || '',
                        hero_image_url: config.hero_image_url || ''
                    }));
                    
                    console.log('✅ Configurações atualizadas no DOM e localStorage');
                    
                    // MOSTRAR conteúdo após carregar dados
                    document.body.classList.add('content-loaded');
                } else {
                    const errorText = await response.text();
                    throw new Error(`HTTP ${response.status}: ${errorText}`);
                }
            } catch (error) {
                console.warn('⚠️ Erro ao carregar config do banco, usando cache local:', error);
