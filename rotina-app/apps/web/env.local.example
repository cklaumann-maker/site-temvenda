# Supabase Configuration
# Para desenvolvimento local, você pode usar Supabase local ou remoto

# Opção 1: Supabase Remoto (recomendado para começar rápido)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Opção 2: Supabase Local (se estiver rodando supabase local)
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-local
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-local

# Porta do servidor (padrão: 3001 para evitar conflitos)
PORT=3001







